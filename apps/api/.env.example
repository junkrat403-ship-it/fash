# Backend API Environment Variables

# Database Connection (Render Managed PostgreSQL or Local PostgreSQL)
DATABASE_URL="postgresql://fashionuser:password@localhost:5432/fashionstoredb?schema=public"

# Application Server Port
PORT=3000

# Environment Mode
NODE_ENV=development

# JWT Secret Keys (Generate strong random strings in production)
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_67890

# Frontend URLs for CORS Authorization
STOREFRONT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002
