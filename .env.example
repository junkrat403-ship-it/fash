# Node environment
NODE_ENV=development
PORT=3000

# Primary Database (PostgreSQL 18)
DATABASE_URL="postgresql://fashion_user:fashion_password@localhost:5432/fashion_db?schema=public"

# Redis (Redis 8)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-access-token-key-change-in-prod
JWT_EXPIRATION=1d
JWT_REFRESH_SECRET=super-secret-refresh-token-key-change-in-prod
JWT_REFRESH_EXPIRATION=7d

# Storefront & Admin URLs
STOREFRONT_URL=http://localhost:3001
ADMIN_URL=http://localhost:3002

# WhatsApp Store Configuration
STORE_WHATSAPP_NUMBER=6281234567890
