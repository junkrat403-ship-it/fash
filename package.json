{
  "name": "fashion-store-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:tunnel": "devtunnel host -p 3000 -p 3001 -p 3002 --allow-anonymous",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @fashion-store/api db:generate",
    "db:push": "pnpm --filter @fashion-store/api db:push",
    "db:seed": "pnpm --filter @fashion-store/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0",
    "eslint": "^9.18.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  }
}
